{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Concessionaria",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "main.c",
                "menus.c",
                "veiculos.c",
                "clientes.c",
                "arquivos.c",
                "-o",
                "concessionaria"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
